# ---------------------------------------------------------------------------
# GlyphAura Studio — server configuration
# Copy to .env  ( cp .env.example .env )  and fill in your key.
# The key is ONLY ever read by the Node server. It is never sent to the browser.
# ---------------------------------------------------------------------------

# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Multimodal model used for reference-image style analysis, OCR and transliteration.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Image model used for AI raster poster generation.
# Leave empty to disable the AI Image engine (the local Vector engine keeps working).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Port for the API server (Vite dev server proxies /api here).
API_PORT=8787

# Port Vite listens on during development.
PORT=5173

# Max upload size accepted by /api/* endpoints, in megabytes.
MAX_UPLOAD_MB=12
